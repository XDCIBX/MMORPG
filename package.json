{
  "name": "realm-of-three-crowns",
  "version": "1.0.0",
  "private": true,
  "description": "Браузерная 3D RPG в стиле MMORPG на Three.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/game.js",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2020 --sourcemap --outfile=dist/game.js --watch",
    "serve": "npx --yes http-server -c-1 -p 8080 ."
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
